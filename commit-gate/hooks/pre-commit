#!/bin/sh
# commit-gate — native git pre-commit hook.
# Blocks a commit whose STAGED diff contains a secret. Covers commits made from
# the shell (the PreToolUse hook covers commits the model makes via Bash).
# Install: copy to <repo>/.git/hooks/pre-commit (chmod +x), OR point
# `git config core.hooksPath` at a dir containing this file.
#
# Fail CLOSED (F-M2.7): if the repo cannot be resolved, the scanner is missing, or
# the scanner errors (status not 0/1), the commit is BLOCKED with "broken, fix it".

# Set this to wherever you cloned the suite:

SCANNER="/path/to/claude-skill-suite/history-leak-scan/pm-secretscan.js"
REPO=$(git rev-parse --show-toplevel)

# A gate that cannot run must BLOCK (F-M2.7): every branch below that used to
# print "SKIPPED (fail-open)" and exit 0 was a silent bypass of the secret gate.
if [ -z "$REPO" ]; then
  echo "commit-gate: cannot resolve repo - secret gate broken, fix it" >&2
  exit 1
fi

# Without this guard a missing scanner makes node exit 1, which the branch below
# reports as "a secret was detected" — blocking the commit with a false reason.
if [ ! -f "$SCANNER" ]; then
  echo "commit-gate: scanner not found at $SCANNER - secret gate broken - fix it" >&2
  exit 1
fi

node "$SCANNER" --staged "$REPO"
status=$?
if [ "$status" -eq 1 ]; then
  echo "" >&2
  echo "commit-gate: a secret was detected in the STAGED diff — commit BLOCKED." >&2
  echo "Remove it from the diff; if it is a live credential, rotate it (secret-rotation)" >&2
  echo "and update .claude/secrets-inventory.md before retrying." >&2
  echo "(To override in a true emergency: git commit --no-verify — do NOT make this a habit.)" >&2
  exit 1
elif [ "$status" -ne 0 ]; then
  echo "commit-gate: scanner error (exit $status) - secret gate broken - fix it. Check node + $SCANNER" >&2
  exit 1
fi
exit 0
